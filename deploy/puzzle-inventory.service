# Template: install.sh fills in __USER__, __APP_DIR__ and __NODE__.
[Unit]
Description=Puzzle Inventory App
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__NODE__ server.js
Environment=NODE_ENV=production
Environment=PORT=3000

Restart=on-failure
RestartSec=5

# Gives the app time to finish pending writes on stop/restart
TimeoutStopSec=10

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
